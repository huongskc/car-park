ALPR_API_KEY=replace-with-a-long-random-secret
CAMERA_INDEX=0
# Norm coordinates x1,y1,x2,y2: 0.0..1.0. Leave full image for early tests.
ROI_IN=0,0,1,1
ROI_OUT=0,0,1,1

YOLO_MODEL=./models/license_plate.pt   # tệp trọng số YOLO (định danh biển số)
YOLO_CONF=0.2                          # ngưỡng độ tin cậy
YOLO_IMG_SIZE=960                      # khung hình đầu vào cho YOLO
YOLO_PAD_FACTOR=0.08                   # viền padding 8% quanh bounding‑box nhận diện

# Optional second local plate detector, compared with the primary model by the image/webcam pipeline.
# Empty value disables fallback. Paths are relative to the project directory.
YOLO_FALLBACK_MODEL=images/DetectLisence_YOLO11.pt

# OCR: auto selects the local specialist when its model/config exist.
# easyocr retains the legacy reader for controlled comparisons.
OCR_ENGINE=auto
PLATE_OCR_MODEL=models/plate_ocr/cct_s_v2_global.onnx
PLATE_OCR_CONFIG=models/plate_ocr/cct_s_v2_global_plate_config.yaml
