# ==============================================================================
# SMART PARKING SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy file này thành .env và điền các thông số thực tế của bạn
# Tuyệt đối không commit file .env chứa mật khẩu thật lên GitHub!
# ==============================================================================

# Cấu hình ứng dụng Backend
APP_NAME=Smart Parking Backend
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Cấu hình Cơ sở dữ liệu MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=smart_parking_db

# Cấu hình Mosquitto MQTT Broker
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=smart_parking_backend
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_BASE_TOPIC=parking
SITE_ID=PTIT_ZONE_1

# Cấu hình Bảo mật & Xác thực JWT
# Sinh khóa ngẫu nhiên: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_a_secure_random_secret_key_minimum_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cấu hình Tích hợp Module ALPR (Nhận diện biển số xe)
INTERNAL_ALPR_API_KEY=alpr_internal_secure_token_secret_ptit_2026
ALPR_SERVICE_URL=http://localhost:5000
# Bật cờ này để tự động sinh biển số giả lập khi demo nếu không có webcam
ENABLE_MOCK_ALPR=true

# Quy tắc nghiệp vụ bãi đỗ xe
PARKING_FLAT_FEE=20000
SERVO_OPEN_TIMEOUT_SEC=10
HEARTBEAT_TIMEOUT_SEC=30
DISTANCE_THRESHOLD_CM=15.0
